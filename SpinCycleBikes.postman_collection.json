                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one rental",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/rentals/1"
