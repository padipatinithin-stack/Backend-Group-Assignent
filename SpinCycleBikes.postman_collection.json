{
  "info": {
    "name": "SpinCycle Bikes API",
    "description": "Complete test collection for SpinCycle Bikes campus bike share API.\nBDF Group Assignment — ST-CSE2D-G03 — Group 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Root",
      "item": [
        {
          "name": "Welcome",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has endpoints list', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('endpoints');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Riders",
      "item": [
        {
          "name": "Get all riders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/riders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one rider",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/riders/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has rider fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('name');",
                  "  pm.expect(body).to.have.property('email');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get rider — not found",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/riders/999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add a rider",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/riders",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dave Wilson\",\n  \"email\": \"dave@campus.edu\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns created rider', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.name).to.eql('Dave Wilson');",
                  "});",
                  "pm.collectionVariables.set('newRiderId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add rider — validation error",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/riders",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Has error message', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('error');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update a rider",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/riders/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Updated\",\n  \"email\": \"alice@campus.edu\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Name is updated', () => {",
                  "  pm.expect(pm.response.json().name).to.eql('Alice Updated');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete a rider",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/riders/{{newRiderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bikes",
      "item": [
        {
          "name": "Get all bikes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bikes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one bike",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bikes/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has bike fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('name');",
                  "  pm.expect(body).to.have.property('type');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search bikes by type",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bikes?type=mountain"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns filtered array', () => {",
                  "  const bikes = pm.response.json();",
                  "  pm.expect(bikes).to.be.an('array');",
                  "  bikes.forEach(b => pm.expect(b.type.toLowerCase()).to.eql('mountain'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TWIST Test 1 — Add Bike 7 → 201",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bikes",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bike 7\",\n  \"type\": \"road\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TWIST Test 1: Status 201 — Bike 7 created', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Name is Bike 7', () => {",
                  "  pm.expect(pm.response.json().name).to.eql('Bike 7');",
                  "});",
                  "pm.collectionVariables.set('bike7Id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TWIST Test 2 — Add \"bike 7\" → 409",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bikes",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"bike 7\",\n  \"type\": \"hybrid\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TWIST Test 2: Status 409 — duplicate name rejected', () => {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Error says already exists', () => {",
                  "  pm.expect(pm.response.json().error).to.include('already exists');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TWIST Test 3 — Rename to same name → 409",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/bikes/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bike 7\",\n  \"type\": \"mountain\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TWIST Test 3: Status 409 — rename to duplicate rejected', () => {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Error says already exists', () => {",
                  "  pm.expect(pm.response.json().error).to.include('already exists');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Add bike — validation error",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bikes",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Has error message', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('error');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update a bike",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/bikes/2",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bike 2 Updated\",\n  \"type\": \"road\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Name is updated', () => {",
                  "  pm.expect(pm.response.json().name).to.eql('Bike 2 Updated');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Bike 7 (cleanup)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/bikes/{{bike7Id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
