              }
            }
          ]
        },
        {
          "name": "Update rental — mark returned",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/rentals/{{newRentalId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rider_id\": 1,\n  \"bike_id\": 3,\n  \"returned_at\": \"2026-11-09 18:00:00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has returned_at', () => {",
                  "  pm.expect(pm.response.json().returned_at).to.not.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete a rental",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/rentals/{{newRentalId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "JOIN — Rental details (rider + bike names)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/rentals/details/all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has joined fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "  if (body.length > 0) {",
                  "    pm.expect(body[0]).to.have.property('rider_name');",
                  "    pm.expect(body[0]).to.have.property('bike_name');",
                  "    pm.expect(body[0]).to.have.property('rented_at');",
                  "  }",
                  "});"
                ]
              }
            }
